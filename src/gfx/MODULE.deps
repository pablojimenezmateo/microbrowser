purpose: Software rasterization. Pixels in memory; nothing about windows or the web.

allow: util

public: Geometry.h AffineTransform.h Color.h ColorText.h Blitter.h Font.h FontCatalog.h TextRenderer.h Canvas.h DirtyRegion.h DisplayList.h DisplayListDiff.h Path.h PathFlattener.h GlyphCache.h Image.h JpegDecoder.h PngDecoder.h SvgDecoder.h SvgPath.h Rasterizer.h Stroker.h Surface.h TextShaper.h Painter.h SfntContainer.h Woff2.h

# JpegPixels.h is deliberately absent from that list: it is the seam between the
# JPEG decoder's parser half and its arithmetic half, and nothing outside this
# module has any business holding a plane of coefficients.

# SDL is deliberately absent, and that absence is load-bearing: it is what makes
# "gfx must not include SDL" an enforced rule rather than a convention.
#
# FreeType and HarfBuzz are here because ADR 0001 sanctions them for exactly one
# module, and this is it. Their types appear in no public header -- Font.h
# type-erases FT_Library and FT_Face to void* for that reason -- so the seam is
# real rather than declared.
extern: freetype harfbuzz

max_tu_lines: 800

# The WOFF2 reader, private to this module. Large for a reader because its two
# non-trivial reads -- WOFF2's base-128 lengths and its byte ranges -- carry the
# reasoning for their refusals where the refusal is, and both halves of the
# decoder read through this one copy rather than two.
budget: Reader       header_lines=90 public_methods=13 members=3
budget: Color        header_lines=35 public_methods=14 members=1
budget: FloatRect    header_lines=40 public_methods=8  members=4
# Inflated() computes in 64 bits and clamps, with the reasoning next to it:
# the amount can be a stroke outset derived from an attacker's stroke width,
# so the int form of the arithmetic is a signed overflow. Found by fuzzing.
budget: IntRect      header_lines=100 public_methods=16 members=4
budget: Canvas       header_lines=80 public_methods=20 members=4
budget: DirtyRegion  header_lines=60 public_methods=10 members=1
# Raised for text, then for images. Each needs a side table the shape commands
# do not: a command must stay 24 bytes, and neither a std::string nor a bitmap
# fits in one. The alternative for text was a command carrying a font handle,
# which would make the list unserializable and so unable to cross the process
# boundary it exists to cross. For images the table holds shared_ptrs, so
# copying a list per frame copies pointers rather than a page of bitmaps.
# One more method for the surface hole, and no more members: a surface is named
# rather than stored, so unlike every other resource here it needs no side
# table. That asymmetry is the point -- see gfx/Surface.h. ADR 0013.
# +2 methods and +1 member for ADR 0014 §4's transform: PushTransform/PopTransform
# and the matrix table they name, which exists for the same reason the path table
# does -- a matrix does not fit in a 24-byte command.
budget: DisplayList  header_lines=115 public_methods=25 members=6
# The surface itself, its registry and one placement.
#
# A Surface is a value with an identity, which is why it is a class rather than
# a struct: the generation counter is the whole damage model for video and it
# must only ever be advanced by replacing the contents, never set. The registry
# is a map because the lookup has to be able to fail -- that failure is what
# makes an id safe to accept across a trust boundary.
budget: Surface         header_lines=45 public_methods=12 members=4
budget: SurfaceRegistry header_lines=35 public_methods=10 members=2
budget: SurfacePlacement header_lines=20 public_methods=2 members=2
budget: Path           header_lines=50 public_methods=20 members=4
# Raised from 30 when Rasterize gained a transform parameter: the transform is
# applied during flattening rather than by the caller, so the tolerance is
# measured in the space the pixels are in.
budget: PathRasterizer header_lines=40 public_methods=8  members=2
# The scaled DrawImage overload and the reasoning for choosing bilinear. Both
# image entry points are here rather than one taking an optional rect, so that
# "this call resamples" is visible at the call site.
budget: Painter        header_lines=115 public_methods=21 members=6
budget: GlyphCache     header_lines=60 public_methods=14 members=8
budget: Image          header_lines=45 public_methods=16 members=4
budget: FontLibrary    header_lines=30 public_methods=8  members=1
budget: FontFace       header_lines=45 public_methods=16 members=2
budget: Font           header_lines=50 public_methods=14 members=3
budget: TextShaper     header_lines=40 public_methods=10 members=6
budget: FontProvider   header_lines=60 public_methods=8  members=0
# The matcher is public and static, with its reasoning next to it, because
# platform's font database ranks files it has not loaded by the same rule. Two
# implementations of "which face answers this request" would drift.
#
# Raised for the font stack: a request names a list of families, not one, so
# "which family did we settle on" became "in what order do we try them". That
# is FamilyCandidates and FamilyRank, and both are public for the same reason
# the matcher is -- platform ranks unloaded files against the identical list,
# and a second implementation of the ordering would page in a file the matcher
# then declines to use.
# 115 lines and a sixteenth method for ADR 0024: RegisterWebFont, which for a
# catalog is an ordinary registration -- the family, weight and slant come from the
# `@font-face` descriptors rather than from the file, because the descriptors are
# what a `font-family` stack names.
# 130 lines and 18 methods: per-character font fallback added `FontForCodePoint` and the coverage
# primitive it is built from. The pair is deliberate -- one answers with a font (the preferred face
# when nothing covers the character, because a visible box is the honest glyph) and the other answers
# the coverage question a caller needs to decide whether to keep looking.
# 175 lines and a seventh member for the match cache. Choosing a face is a pass
# over every registered face, and it was being redone per text measurement --
# 985,000 times against 490 faces on en.wikipedia.org/wiki/CSS, which was 227 of
# that page's 259 seconds. The lines are the key (what a match depends on, and
# what it deliberately does not: size) and the invalidation rule, which is the
# part that has to be right -- a stale entry here is the wrong typeface drawn
# with the right metrics.
budget: FontCatalog header_lines=175 public_methods=18 members=7
# Owns a shaper and an LRU of shaped runs, which is four members before the
# provider it borrows. Shaping is the most expensive step in the text stack and
# the cache is why this type exists at all -- see the class comment.
# 80 lines for per-character font fallback: the coverage split is the unit both painting and
# measuring use, so that the two cannot disagree about where a fallback began.
budget: TextRenderer   header_lines=80 public_methods=12 members=6
budget: AffineTransform header_lines=70 public_methods=22 members=6
