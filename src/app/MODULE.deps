purpose: Host process. Owns the window, the canvas, the transport, and the loop.

allow: util gfx ipc engine platform

public: AppStartupOptions.h Application.h IdleWaitStrategy.h EventDrainBudget.h DirtyRegionPolicy.h

# Empty, and this is the check that keeps the app loop honest: every way the
# process sleeps goes through platform::SdlWindow, so the loop policy can be
# unit-tested with no window system present.
extern:

max_tu_lines: 800

# Application is this project's candidate god object -- the browser equivalent
# of the UI shell that slowly absorbs everything. Tabs, omnibox, history, and
# settings get their own types in src/ui when M7 arrives; Application routes.
# Three more members for the font stack: the FreeType library, the system font
# database, and the shaped-run cache. They are here because the engine takes a
# gfx::FontProvider rather than finding one -- which is what keeps "the engine
# does not know what machine it is on" true.
budget: Application header_lines=95 public_methods=6 members=16
