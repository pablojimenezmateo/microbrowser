purpose: JavaScript. Lexing, parsing, and execution. Knows nothing about the DOM.

# Notably absent: dom. A JS engine that could reach into the DOM directly would
# make the binding layer optional, and the binding layer is where every
# same-origin check will live. Bindings arrive in M9 as a separate seam.
allow: util

# StructuredClone.h is public because the *host* needs it, not because anything
# in this module does: ADR 0026 §1 stores `history.state` as bytes rather than as
# a live value, because a history entry outlives the document that created it.
# ADR 0021's storage and ADR 0022's workers want the same function for the same
# reason.
#
# StringUnits.h is public for the same shape of reason. A DOMString is defined as
# a sequence of UTF-16 code units, so `data.length`, every CharacterData offset
# and every Range boundary in `src/bindings` is counted in them -- over storage
# that is UTF-8 everywhere in this browser. That conversion exists here already,
# with an ASCII fast path and the lone-surrogate rule written down; a second copy
# in the binding layer would be a second answer to "what is position 3", which is
# precisely the disagreement the header exists to prevent.
public: Token.h Lexer.h Ast.h Parser.h Value.h Heap.h Interpreter.h Bytecode.h StructuredClone.h StringUnits.h

extern:

# 1340 rather than 1300, and the reason is that Vm.cpp is **one function**:
# `RunFrames`, the machine's dispatch loop, from line 47 to the end. The usual remedy
# for a file over its cap -- find the module hiding in it -- does not apply to a switch
# over an opcode set: the cases share the loop's `pending`, `threw` and operand stack,
# so moving them to another translation unit means either passing that state through a
# seam per opcode or building a second dispatch mechanism. Both are worse than a long
# switch. Raised in session 22 by the property-read fix, which added thirteen lines to
# it (an exception thrown by a getter or a Proxy trap used to be swallowed).
max_tu_lines: 1360

budget: Token  header_lines=40 public_methods=8  members=9
