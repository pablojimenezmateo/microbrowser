purpose: The UI/Engine seam. A closed message vocabulary and a swappable transport.

allow: util gfx

public: ByteStream.h Message.h Transport.h InProcessTransport.h

extern:

max_tu_lines: 800

# One more of each for WriteU16/ReadU16, which ADR 0017's `buttons` field is:
# the DOM defines it as an unsigned short and it is the value a page reads back
# as `event.buttons`, so widening or narrowing it at the seam would make the
# wire format and the property disagree about a type.
budget: ByteWriter        header_lines=52 public_methods=11 members=1
budget: ByteReader        header_lines=92 public_methods=15 members=3
# The two input messages of ADR 0017 §1. Budgets because each field here is
# something the host claims about the user's hands and the engine believes: a
# message that grows is a wider claim, and it should be a decision.
budget: PointerInputMessage header_lines=30 public_methods=0 members=7
budget: KeyInputMessage     header_lines=25 public_methods=0 members=6
budget: InProcessChannel  header_lines=60 public_methods=6  members=4
