# Module contract for src/util.
#
# Format is documented in guidelines/architecture.md. Every field is enforced by
# tests/ArchitectureInvariantsTests.cpp; editing a budget upward is a reviewable
# act, which is the entire point of writing them down.

purpose: Dependency-free primitives. Parsing, strings, tracing, counters.

# The bottom of the stack. util depends on nothing, which is what makes it safe
# for every other module to depend on it.
allow:

# WaitDescriptor.h is here rather than in net because it is the vocabulary of a
# handoff between three modules that may not include each other: net produces
# descriptors, app puts them in the idle-wait decision, and platform waits on
# them. See ADR 0011.
# UserAgent.h is public for the same reason WaitDescriptor.h is: it is the
# vocabulary of a handoff between two modules that may not include each other.
# net sends the string and bindings tells script the string, and they have to be
# the same string -- a page that sniffs both would otherwise get two answers.
# PercentEncoding.h and UrlEncoded.h are here for the same reason, and it is
# the stronger case of the three: url, privacy, engine and bindings all decode
# percent escapes, and bindings may see only util, js and dom. Three separate
# copies of the decoder existed before this line did. Two decoders that
# disagree about what a URL means is a security bug, not a compatibility one.
# Base64.h and Sha2.h are here for the same reason and the strongest case yet:
# `src/csp` may see only util and url, `src/engine` verifies Subresource
# Integrity, and `src/engine` already decoded base64 for `data:` URLs. A digest
# in `net` -- where the TLS stack's already is -- would be one that two of those
# three callers cannot reach, and reaching it would mean widening a policy
# module's allow: line to a module that can open sockets. See Sha2.h.
# Sha1.h is here for exactly one caller -- RFC 6455's handshake check -- and its header
# says so at length: SHA-1 is broken for anything that needs collision resistance, and a
# second caller is a bug rather than a reuse.
public: AesCtr.h Base64.h BlobUrlRegistry.h Brotli.h Hmac.h HttpDate.h Sha1.h Sha2.h Env.h Inflate.h Parse.h PercentEncoding.h StringUtil.h SaturatingMath.h TransparentStringHash.h TraceChannel.h StartupTrace.h PerformanceTrace.h PerformanceCounters.h LoadTimeline.h UrlEncoded.h WaitDescriptor.h UserAgent.h Random.h

# Brotli's decoder, and nothing else from it. ADR 0024 sanctions the dependency
# and ADR 0001's rule is that one earns its place: this is `Content-Encoding: br`
# -- what the web actually serves -- and the inner half of WOFF2 -- what every web
# font actually ships as. Exactly one file names it, Brotli.cpp, and `libbrotlienc`
# is deliberately not linked because a browser has no reason to compress.
extern: brotli

# 850 rather than 800, and PerformanceCounters.h is the only file near it. That file
# is a *registry*: one `X(...)` line per counter, each with the comment that says
# what a non-zero reading means, and the usual remedy for a file over its cap --
# find the module hiding in it -- is the wrong move here. The value of the table is
# that there is exactly one of it: `MICROBROWSER_PERF_COUNTERS=1` dumps every
# non-zero counter in one pass, the ids are one enum, and splitting it by subject
# would mean two enums, two dumps, and a counter whose home is arguable.
#
# The thing worth guarding here is not the line count -- it is that every counter
# carries the sentence saying how to read it, which is the lesson
# `font.lookup_hits` cost 227 seconds to learn: a counter on the cheap half of an
# operation is worse than no counter, because it reads as evidence the operation is
# fine. Those comments are why the file is long, and they are the part that must not
# be trimmed to fit a number. Raised by ADR 0042's three realm counters.
max_tu_lines: 850

budget: TraceChannel     header_lines=170 public_methods=20 members=10
budget: TraceScope       header_lines=30  public_methods=4  members=7
budget: PerformanceTrace header_lines=130 public_methods=16 members=0
budget: StartupTrace     header_lines=50  public_methods=10 members=0
budget: ScopeLabel       header_lines=45  public_methods=8  members=3

# When each thing in a page load first happened, on one clock. One member's
# worth of state behind a static facade, like the trace channels beside it: the
# thing being measured is a *navigation*, of which there is one at a time.
budget: LoadTimeline  header_lines=35 public_methods=8 members=0
